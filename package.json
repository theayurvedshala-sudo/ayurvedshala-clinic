  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "dev:server": "nodemon server/index.js",
    "dev:lan": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
